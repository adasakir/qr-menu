{
  "name": "kahvebahane-admin",
  "version": "1.0.0",
  "description": "Kahvebahane Admin Modu - masaustu uygulamasi",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.kahvebahane.admin",
    "productName": "Kahvebahane Admin",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "kahvebahane-server.json",
      "package.json",
      "renderer/**/*"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "renderer/img/logo.png"
    },
    "portable": {
      "artifactName": "Kahvebahane-Admin-Portable.exe"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
